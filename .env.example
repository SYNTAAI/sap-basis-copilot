# SAP Basis Copilot — configuration template.
# Copy to .env and fill in your own values. Key names only; never commit a secret.

# --- SAP connection (used by the JCo bridge) ---
SAP_ASHOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWD=
SAP_LANG=

# --- local JCo REST bridge ---
JCO_BASE_URL=

# --- MCP transport ---
# stdio (default) for Claude Desktop; http for a hosted install.
MCP_TRANSPORT=
MCP_HOST=
MCP_PORT=

# --- hosted mode only (ignored for stdio) ---
MCP_NO_AUTH=
SYNTAAI_ISSUER_URL=
SYNTAAI_DATA_DIR=
LOG_LEVEL=
